  <ul class="dark:text-zinc-300">
    <li><a href="tutorials/wk03" class="text-inherit">Week 3</a></li>
    <li><a href="tutorials/wk04" class="text-inherit">Week 4</a></li>
    <li><a href="tutorials/wk05" class="text-inherit">Week 5</a></li>
    <li><a href="tutorials/wk07" class="text-inherit">Week 7</a></li>
  </ul>
   -->
  <h2 class="dark:text-zinc-300">Course Notes</h2>
  <ul class="dark:text-zinc-300">
    {notes.map((note) => (
      <li><a href={note.slug} class="text-inherit">{note.title}</a></li>
    ))}
  </ul>

  <p class="mt-12 text-sm text-zinc-500 dark:text-zinc-400 border-t border-zinc-300 dark:border-zinc-700 pt-4">
