---
import Layout from "../layouts/Layout.astro";
import fs from 'fs';

const brens = fs.readdirSync('public/assets/images/bren');

---

<Layout title="Courses">
  <div class="grid gap-3 md:grid-cols-3 sm:grid-cols-2 grid-cols-1">
    {brens.map(b => (
      <div class="aspect-square overflow-hidden">
        <img src={`/assets/images/bren/${b}`} alt="" class="w-full h-full object-cover mt-0"/>
      </div>
    ))}
  </div>
</Layout>